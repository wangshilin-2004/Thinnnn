.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# ── 环境变量：密钥的防线 ───────────────────────────────────────
# 模式说明：先全部忽略，再显式放行模板文件。
# 这样将来新增 .env.production、.env.development 时，
# 你会自动受到保护 —— 不需要记得回来改这个文件。
.env*
!.env.example

# ── 测试与覆盖率 ──────────────────────────────────────────────
coverage/

# ── 日志 ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

