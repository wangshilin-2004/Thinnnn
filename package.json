{
  "name": "slim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "体重 + 饮食可视化管理 · Apple 发布会风格",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "next build",
    "db:dev": "node scripts/dev-db.mjs",
    "db:dev:reset": "node scripts/dev-db.mjs --reset",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:verify": "node tests/verify-migrations.mjs",
    "db:verify:hosted": "node tests/verify-hosted.mjs",
    "dev": "next dev",
    "lint": "eslint",
    "seed:build": "node scripts/build-seed.mjs",
    "seed:dev": "node scripts/seed-dev-data.mjs",
    "start": "next start",
    "test": "node --test tests/nutrition.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run actions:verify && npm run db:verify",
    "actions:verify": "node tests/verify-server-actions.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.58.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
