# ═══════════════════════════════════════════════════════════════
#  环境变量模板
#
#  用法：复制这个文件为 .env.local，填入真实值。
#      cp .env.example .env.local
#
#  ⚠️  .env.local 已被 .gitignore 排除，永远不会进 Git。
#      .env.example（本文件）会进 Git，所以里面只能放「占位符」，
#      任何真实密钥都不许写进来。
#
#  为什么密钥要放环境变量而不是写死在代码里：
#    代码会进 Git → 推到 GitHub → 可能是公开仓库 → 密钥泄露。
#    GitHub 上有爬虫 7×24 小时扫 API key，泄露的 key 通常在
#    几分钟内就会被用来挖矿 / 刷账单。而 Git 历史一旦推上去，
#    就算你立刻删掉文件，历史里依然查得到 —— 只能轮换密钥。
# ═══════════════════════════════════════════════════════════════


# ── 1. 浏览器可见的配置（NEXT_PUBLIC_ 前缀）─────────────────────
# Next.js 的约定：只有 NEXT_PUBLIC_ 开头的变量才会被打包进浏览器代码。
# 所以 key 的名字本身就是一道安全边界 —— 没有这个前缀的变量，
# 你在客户端组件里访问会得到 undefined，而不是「悄悄泄露」。

# Supabase 项目地址，形如 https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon key（公开的匿名密钥）
# 「公开」不是笔误：它确实会出现在浏览器里，设计上就是如此。
# 安全边界不在这把钥匙上，而在数据库的 RLS 策略上 ——
# 策略决定了这把钥匙能打开哪些行。
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── 2. 仅服务端可见的机密（绝对不许加 NEXT_PUBLIC_ 前缀）────────

# service_role key：绕过所有 RLS，等于数据库管理员。
# 只在服务端使用（比如验证邀请码、管理端操作）。
SUPABASE_SERVICE_ROLE_KEY=


# ── 3. 数据库连接串 ───────────────────────────────────────────

# 连接池地址（Supabase 面板 → Connect → Transaction pooler，端口 6543）
# 运行时用这个。Serverless 环境会开大量短连接，直连会打爆数据库。
# 注意：连接串里的密码部分如果含特殊字符需要 URL 编码。
DATABASE_URL=

# 直连地址（端口 5432）
# 迁移用这个。原因见 drizzle.config.ts 里的注释。
DIRECT_URL=


# ── 4. 邀请码管理员（可选）────────────────────────────────────

# 谁能看到 /settings 里的「邀请码」卡片。
# 逗号分隔，写邮箱（不区分大小写）。留空 = 没有管理员 = 谁都看不到那张卡片，
# 但已经发出去的码照样能用 —— 「没人能发新码」比「绕过门槛」安全。
OWNER_EMAILS=
